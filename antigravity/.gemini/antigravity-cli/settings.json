{
  "agentMode": "",
  "enableTerminalSandbox": true,
  "model": "Gemini 4 Hydrogen (Medium)",
  "permissions": {
    "allow": [
      "command(ls)",
      "command(pwd)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(rg)",
      "command(grep)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git branch --list)",
      "command(git rev-parse)",
      "command(regex:(npm|pnpm|yarn) (test|run (lint|typecheck|test|build)))",
      "command(pytest)",
      "command(go test)",
      "command(regex:cargo (test|check|clippy))",
      "command(npx tsc --noEmit)",
      "command(npx eslint)",
      "command(npx vitest run)",
      "command(npx jest)",
      "command(uv)"
    ],
    "deny": [
      "read_file(**/.env*)",
      "read_file(**/*.pem)",
      "read_file(**/*.key)",
      "read_file(~/.ssh/**)",
      "read_file(~/.aws/**)",
      "read_file(~/.config/**)",
      "command(rm)",
      "command(sudo)",
      "command(su)",
      "command(chmod)",
      "command(chown)",
      "command(dd)",
      "command(mkfs)",
      "command(shutdown)",
      "command(reboot)",
      "command(git push)",
      "command(git reset --hard)",
      "command(git clean -f)",
      "command(git branch -D)",
      "command(curl)",
      "command(wget)",
      "command(ssh)",
      "command(scp)",
      "command(nc)",
      "command(eval)",
      "command(regex:(bash|sh|zsh|python|node) -(c|e).*)"
    ],
    "ask": [
      "command(regex:.*([;\u0026|]|\u003e|\u003e\u003e).*)"
    ]
  },
  "trustedWorkspaces": [
    "/home/deffa/Documents/Notes/Network",
    "/home/deffa/Proyekt/klee",
    "/tmp",
    "/home/deffa",
    "/home/deffa/.config/systemd/user",
    "/home/deffa/Proyekt/homelab",
    "/home/deffa/dotfiles",
    "/home/deffa/.gemini/antigravity-cli",
    "/home/deffa/.gemini/config"
  ]
}
